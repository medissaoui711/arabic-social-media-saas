generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}
enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  VIEWER
}
enum ContentStatus {
  draft
  ready
  archived
}
enum ScheduleStatus {
  scheduled
  cancelled
  due
  completed
  failed
}
enum SocialPlatform {
  facebook
  instagram
  tiktok
  youtube
  linkedin
  x
  other
}
model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique @db.VarChar(320)
  passwordHash String @map("password_hash") @db.VarChar(255)
  displayName String @map("display_name") @db.VarChar(120)
  disabledAt DateTime? @map("disabled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  sessions Session[]
  auditEvents AuditEvent[] @relation("AuditActor")
  @@map("users")
}
model Session {
  id String @id @default(uuid()) @db.Uuid
  tokenHash String @unique @map("token_hash") @db.Char(64)
  userId String @map("user_id") @db.Uuid
  expiresAt DateTime @map("expires_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, expiresAt])
  @@map("sessions")
}
model Workspace {
  id String @id @default(uuid()) @db.Uuid
  name String @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships Membership[]
  contents ContentItem[]
  auditEvents AuditEvent[]
  mediaAssets MediaAsset[]
  schedules ScheduleJob[]
  socialAccounts SocialAccount[]
  @@map("workspaces")
}
model Membership {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role WorkspaceRole
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, userId])
  @@index([userId, workspaceId])
  createdContent ContentItem[] @relation("ContentCreator")
  createdMedia MediaAsset[] @relation("MediaCreator")
  @@map("memberships")
}
model ContentItem {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  title String @db.VarChar(180)
  body String @db.Text
  status ContentStatus @default(draft)
  createdById String @map("created_by_id") @db.Uuid
  scheduledAt DateTime? @map("scheduled_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Membership @relation("ContentCreator", fields: [workspaceId, createdById], references: [workspaceId, userId], onDelete: Restrict)
  @@index([workspaceId, status, updatedAt(sort: Desc)])
  @@index([workspaceId, scheduledAt])
  @@unique([workspaceId, id])
  schedules ScheduleJob[]
  @@map("content_items")
}
model MediaAsset {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  createdById String @map("created_by_id") @db.Uuid
  storageKey String @unique @map("storage_key") @db.VarChar(255)
  originalName String @map("original_name") @db.VarChar(180)
  mimeType String @map("mime_type") @db.VarChar(100)
  sizeBytes Int @map("size_bytes")
  sha256 String @db.Char(64)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy Membership @relation("MediaCreator", fields: [workspaceId, createdById], references: [workspaceId, userId], onDelete: Restrict)
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("media_assets")
}
model ScheduleJob {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  contentId String @map("content_id") @db.Uuid
  status ScheduleStatus @default(scheduled)
  scheduledAt DateTime @map("scheduled_at") @db.Timestamptz(6)
  timezone String @db.VarChar(64)
  idempotencyKey String @map("idempotency_key") @db.VarChar(128)
  attemptCount Int @default(0) @map("attempt_count")
  claimedAt DateTime? @map("claimed_at") @db.Timestamptz(6)
  completedAt DateTime? @map("completed_at") @db.Timestamptz(6)
  lastError String? @map("last_error") @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  content ContentItem @relation(fields: [workspaceId, contentId], references: [workspaceId, id], onDelete: Restrict)
  events ScheduleEvent[]
  @@unique([workspaceId, idempotencyKey])
  @@unique([workspaceId, id])
  @@index([workspaceId, status, scheduledAt])
  @@map("schedule_jobs")
}
model ScheduleEvent {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  scheduleId String @map("schedule_id") @db.Uuid
  fromStatus ScheduleStatus? @map("from_status")
  toStatus ScheduleStatus @map("to_status")
  detail Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  schedule ScheduleJob @relation(fields: [workspaceId, scheduleId], references: [workspaceId, id], onDelete: Cascade)
  @@index([workspaceId, scheduleId, createdAt])
  @@map("schedule_events")
}
model SocialAccount {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  platform SocialPlatform
  accountName String @map("account_name") @db.VarChar(120)
  handle String @db.VarChar(120)
  notes String? @db.VarChar(1000)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  @@unique([workspaceId, platform, handle])
  @@index([workspaceId, platform])
  @@map("social_accounts")
}
model AuditEvent {
  id String @id @default(uuid()) @db.Uuid
  workspaceId String @map("workspace_id") @db.Uuid
  actorId String? @map("actor_id") @db.Uuid
  action String @db.VarChar(100)
  targetType String @map("target_type") @db.VarChar(80)
  targetId String? @map("target_id") @db.Uuid
  metadata Json @default("{}")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor User? @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  @@index([workspaceId, createdAt(sort: Desc)])
  @@map("audit_events")
}
